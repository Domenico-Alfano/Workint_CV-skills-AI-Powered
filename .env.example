# Copy to `.env` and fill in. `.env` is gitignored.

# --- Local Postgres (docker-compose) ---
LOCAL_DB_URL=postgresql+psycopg2://workint:workint@localhost:5433/skills_benchmark

# --- External read-only DB (your remote Postgres) ---
# Fill in real credentials. Used only to READ the source postings table.
EXTERNAL_JOBS_DB_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# --- Postings source + snapshot window (benchmark unit = distinct job_category) ---
POSTINGS_TABLE=offerte_lavoro
DATE_COLUMN=mapping_timestamp
DATE_FROM=2026-04-01
# DATE_TO=            # leave empty for "up to newest available"
MIN_POSTINGS=10       # build benchmarks for categories with >= this many postings

# --- Demand trend (scripts/compute_trends.py, feeds /skills-gap/recommend-*) ---
TREND_WINDOW_DAYS=90          # two adjacent windows of this many days
TREND_MIN_POSTINGS=30         # below this total the share-growth is noise -> NULL
TREND_ANCHOR_DATE=2025-10-31  # pin to the last healthy date; empty = newest posting

# --- ESCO (pinned for reproducibility) ---
ESCO_VERSION=v1.2.0
ESCO_DATA_DIR=data/esco

# --- Flow 1: external CV extractor (PDF -> markdown) ---
EXTRACTOR_URL=https://ai-services.workint.expleoitalia.it/extract-cv-info
EXTRACTOR_PASSWORD=           # required (header X-Access-Password) — ask the AI-services owner
EXTRACTOR_VERIFY_SSL=false   # host uses a self-signed cert (or set EXTRACTOR_CA_BUNDLE=/path/ca.pem)

# --- API ---
CORS_ORIGINS=*               # set to the Angular origin(s) in production
# API_KEY=                   # if set, /skills-gap/* require the x-api-key header (401 otherwise)

# --- LLM (narrative report + gap-closing suggestions) ---
LLM_PROVIDER=groq            # groq | openai  (no code change needed to switch)
LLM_API_KEY=                 # gsk_... for Groq, sk-... for OpenAI
LLM_MODEL=llama-3.1-8b-instant  # or gpt-4o for OpenAI
